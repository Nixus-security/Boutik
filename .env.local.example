# Copie ce fichier en .env.local et remplis les valeurs
# (Supabase > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optionnel : URL publique du site (utilisée pour les aperçus de partage Open Graph)
NEXT_PUBLIC_SITE_URL=https://boutik.site

# Supabase > Project Settings > API > service_role (secret, jamais exposé au client)
# Nécessaire pour que le webhook Stripe écrive dans la table subscriptions.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe > Developers > API keys
STRIPE_SECRET_KEY=sk_test_remplace_moi
# Stripe > Developers > Webhooks > ta route (signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Stripe > Product catalog > ouvre le produit > section Pricing > ID qui commence par price_ (PAS prod_)
STRIPE_PRICE_ESSENTIEL=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Flutterwave > Settings > API Keys (paiement Mobile Money : Orange Money, MTN, Wave...)
# Inutilisé tant que le KYC compte Flutterwave n'est pas débloqué (FedaPay ci-dessous en alternative).
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
# Flutterwave > Settings > Webhooks > "Secret hash" (chaîne que TU choisis et colles aussi dans leur dashboard)
FLW_WEBHOOK_HASH=xxxxxxxxxxxxxxxxxxxxxxxx

# "true" affiche les boutons Mobile Money ; sinon "bientôt disponible" (laisser vide tant que FedaPay n'est pas prêt)
NEXT_PUBLIC_MOBILE_MONEY_ENABLED=

# FedaPay > Dashboard > Réglages > Clés API (paiement Mobile Money : Orange Money, MTN, Moov...)
# "live" ou "sandbox"
FEDAPAY_ENVIRONMENT=live
FEDAPAY_SECRET_KEY=sk_live_remplace_moi
# Dashboard > Réglages > Webhooks > secret (commence par wh_)
FEDAPAY_WEBHOOK_SECRET=wh_xxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics 4 > Admin > Data Streams > ton flux web > "Measurement ID" (optionnel, rien ne se charge sans)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
